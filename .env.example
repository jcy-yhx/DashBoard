# 复制此文件为 .env.local 并填入真实值

# RPC 节点（至少配置一个 Fallback）
RPC_URL_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_ETHEREUM_FALLBACK=https://mainnet.infura.io/v3/YOUR_KEY
RPC_URL_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_ARBITRUM_FALLBACK=https://arb1.arbitrum.io/rpc

# 数据库
DATABASE_URL=postgresql://localhost:5432/defi_dashboard

# Coingecko (仅作为价格兜底)
COINGECKO_API_KEY=YOUR_KEY

# 应用
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_PROJECT_ID
